{
  "name": "meridian-visit-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visit booking agent for Meridian Homes: MCP tools, Paystack test-mode payments and a coordinator console on one Cloudflare Worker.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply meridian --local",
    "db:migrate:remote": "wrangler d1 migrations apply meridian --remote",
    "db:seed:local": "tsx seed/generate.ts && wrangler d1 execute meridian --local --file seed/seed.sql",
    "db:seed:remote": "tsx seed/generate.ts && wrangler d1 execute meridian --remote --file seed/seed.sql",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "skill:zip": "cd skill && rm -f ../dist/meridian-visit-desk.zip && mkdir -p ../dist && zip -r ../dist/meridian-visit-desk.zip meridian-visit-desk -x '*.DS_Store'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "~4.1.12",
    "wrangler": "^4.152.0"
  }
}
